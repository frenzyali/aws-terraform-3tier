# Copy to envs/prod/terraform.tfvars (gitignored) and edit, then:
#   terraform plan -var-file=envs/prod/terraform.tfvars
environment = "prod"
aws_region  = "us-east-1"

# Pin an immutable tag in prod, never :latest.
app_image = "your-dockerhub-user/3tier-app:1.0.0"

# Resilience: NAT per AZ, bigger and more instances, Multi-AZ database
vpc_cidr             = "10.10.0.0/16"
enable_nat_gateway   = true
single_nat_gateway   = false
app_instance_type    = "t3.small"
app_min_size         = 2
app_desired_capacity = 2
app_max_size         = 6

db_instance_class         = "db.t4g.small"
db_allocated_storage_gb   = 50
db_multi_az               = true
db_backup_retention_days  = 14
db_deletion_protection    = true
db_skip_final_snapshot    = false
alb_deletion_protection   = true

# Strongly recommended in prod: serve HTTPS with an ACM certificate from the same region.
# certificate_arn = "arn:aws:acm:us-east-1:<ACCOUNT_ID>:certificate/<CERTIFICATE_ID>"
